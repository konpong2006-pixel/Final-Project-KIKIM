rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // SmartLife data model:
    // users/{uid}
    // users/{uid}/{schedules|activities|notes|transactions|pendingReview|notifications|scanLogs|aiRecommendations|feedback}/{documentId}
    // users/{uid}/{schedulingBehaviorEvents|schedulingPatterns|schedulingSuggestions|scheduleChangeHistory|productivityInsights|pushTokens}/{documentId}
    // users/{uid}/monthlyBudgets/{monthKey}
    // users/{uid}/settings/adaptiveScheduling
    // users/{uid}/assistantConversations/{conversationId}/messages/{messageId}
    // users/{uid}/integrations/google-calendar
    // Admin access is derived only from the trusted `admin` custom claim.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function hasValidCreateMeta(data, userId) {
      return data.ownerId == userId
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidUpdateMeta(data, userId) {
      return data.ownerId == userId
        && data.ownerId == resource.data.ownerId
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time;
    }

    function validColor(value) {
      return value is string && value.matches('^#[0-9A-Fa-f]{6}$');
    }

    function validProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'avatarUrl', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl', 'role',
          'consentHistory', 'consentTier', 'lineConsentUpdatedAt',
          'lineConsentVersion', 'lineListenerStatus',
          'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.uid is string
        && data.email == request.auth.token.email
        && data.email is string
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 2048
        && (data.avatarUrl == '' || data.avatarUrl.matches('^https://.*'))
        && data.role == 'user'
        && (!('consentHistory' in data) || (data.consentHistory is list && data.consentHistory.size() <= 50))
        && (!('consentTier' in data) || data.consentTier in ['manual_only', 'line_auto_sync'])
        && (!('lineConsentUpdatedAt' in data) || data.lineConsentUpdatedAt is timestamp)
        && (!('lineConsentVersion' in data) || (data.lineConsentVersion is int && data.lineConsentVersion == 1))
        && (!('lineListenerStatus' in data) || data.lineListenerStatus in ['active', 'not_applicable', 'permission_revoked'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMonthlyBudget(data, userId, monthKey) {
      return data.keys().hasAll(['ownerId', 'amount', 'monthKey', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'amount', 'monthKey', 'source', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.monthKey == monthKey
        && data.amount is number
        && data.amount > 0
        && data.amount <= 10000000
        && data.source in ['ai', 'manual']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSchedule(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'courseCode', 'startAt', 'endAt', 'location', 'color', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'courseCode', 'courseName', 'startAt', 'endAt', 'location', 'color', 'seriesId', 'source', 'googleCalendarId', 'googleEventId', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.courseCode is string && data.courseCode.size() <= 40
        && (!('courseName' in data) || (data.courseName is string && data.courseName.size() <= 120))
        && data.startAt is timestamp && data.endAt is timestamp && data.startAt < data.endAt
        && data.location is string && data.location.size() <= 120
        && (!('seriesId' in data) || (data.seriesId is string && data.seriesId.size() >= 1 && data.seriesId.size() <= 128))
        && (!('googleCalendarId' in data) || (data.googleCalendarId is string && data.googleCalendarId.size() <= 128))
        && (!('googleEventId' in data) || (data.googleEventId is string && data.googleEventId.size() <= 512))
        && validColor(data.color)
        && data.source in ['manual', 'ocr', 'google-calendar', 'university']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validActivity(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'type', 'startAt', 'endAt', 'location', 'color', 'status', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'title', 'type', 'startAt', 'endAt', 'location', 'color', 'status', 'source',
          'note', 'reminder', 'category', 'priority', 'attendees',
          'actualDurationMinutes', 'actualEnd', 'actualStart', 'aiConfidence', 'aiReason', 'aiScheduled',
          'allowAiReschedule', 'clientRequestId', 'deadline', 'estimatedDurationMinutes', 'googleCalendarId', 'googleEventId',
          'googleSyncStatus', 'isFlexible', 'isLocked', 'originalScheduledStart', 'scheduleVersion',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.type in ['activity', 'task', 'appointment']
        && data.startAt is timestamp && data.endAt is timestamp && data.startAt < data.endAt
        && data.location is string && data.location.size() <= 120
        && (!('note' in data) || (data.note is string && data.note.size() <= 5000))
        && (!('reminder' in data) || (data.reminder is string && data.reminder.size() <= 160))
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('priority' in data) || (data.priority is string && data.priority.size() <= 24))
        && (!('attendees' in data) || (data.attendees is string && data.attendees.size() <= 500))
        && (!('actualDurationMinutes' in data) || data.actualDurationMinutes == null || (data.actualDurationMinutes is number && data.actualDurationMinutes >= 0 && data.actualDurationMinutes <= 1440))
        && (!('actualEnd' in data) || data.actualEnd == null || data.actualEnd is timestamp)
        && (!('actualStart' in data) || data.actualStart == null || data.actualStart is timestamp)
        && (!('aiConfidence' in data) || data.aiConfidence == null || (data.aiConfidence is number && data.aiConfidence >= 0 && data.aiConfidence <= 1))
        && (!('aiReason' in data) || data.aiReason == null || (data.aiReason is string && data.aiReason.size() <= 600))
        && (!('aiScheduled' in data) || data.aiScheduled is bool)
        && (!('clientRequestId' in data) || (data.clientRequestId is string && data.clientRequestId.size() <= 256))
        && (!('allowAiReschedule' in data) || data.allowAiReschedule is bool)
        && (!('deadline' in data) || data.deadline == null || data.deadline is timestamp)
        && (!('estimatedDurationMinutes' in data) || (data.estimatedDurationMinutes is int && data.estimatedDurationMinutes >= 15 && data.estimatedDurationMinutes <= 720))
        && (!('googleCalendarId' in data) || (data.googleCalendarId is string && data.googleCalendarId.size() <= 128))
        && (!('googleEventId' in data) || (data.googleEventId is string && data.googleEventId.size() <= 512))
        && (!('googleSyncStatus' in data) || data.googleSyncStatus in ['failed', 'not_required', 'pending', 'synced'])
        && (!('isFlexible' in data) || data.isFlexible is bool)
        && (!('isLocked' in data) || data.isLocked is bool)
        && (!('originalScheduledStart' in data) || data.originalScheduledStart == null || data.originalScheduledStart is timestamp)
        && (!('scheduleVersion' in data) || (data.scheduleVersion is int && data.scheduleVersion >= 0))
        && (!('isFlexible' in data) || data.isFlexible == false || (data.type != 'appointment' && (!('attendees' in data) || data.attendees == '')))
        && (!('allowAiReschedule' in data) || data.allowAiReschedule == false || (data.isFlexible == true && data.type != 'appointment' && (!('attendees' in data) || data.attendees == '')))
        && validColor(data.color)
        && data.status in ['planned', 'in-progress', 'completed', 'cancelled']
        && data.source in ['manual', 'ai']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validNote(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'content', 'category', 'relatedScheduleId', 'color', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'content', 'category', 'relatedScheduleId', 'color', 'priority', 'status', 'completedAt', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() <= 20000
        && data.category in ['study', 'work', 'idea', 'personal']
        && data.relatedScheduleId is string && data.relatedScheduleId.size() <= 128
        && validColor(data.color)
        && (!('priority' in data) || data.priority in ['normal', 'important', 'urgent'])
        && (!('status' in data) || data.status in ['pending', 'completed'])
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp)
        && (!('status' in data) || data.status != 'completed' || (('completedAt' in data) && data.completedAt is timestamp))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validTransaction(data, userId) {
      return data.keys().hasAll(['ownerId', 'type', 'amount', 'category', 'merchant', 'note', 'occurredAt', 'receiptPath', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'type', 'amount', 'category', 'merchant', 'note',
          'occurredAt', 'receiptPath', 'accountLast4',
          'balanceAfterReported', 'bank', 'confirmationMethod',
          'confidence', 'dedupeKeys', 'fingerprint', 'items', 'rawTextRetained',
          'reviewedAt', 'reviewedByUser', 'scanId', 'source', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.merchant is string && data.merchant.size() <= 160
        && data.note is string && data.note.size() <= 1000
        && data.occurredAt is timestamp
        && data.receiptPath is string && data.receiptPath.size() <= 512
        // Dedicated receipt scans use /receipts; automatic document scans use
        // /scans and may still be classified as receipts by OCR.
        && (data.receiptPath == '' || data.receiptPath.matches('^users/' + userId + '/(receipts|scans)/.*'))
        && (!('confidence' in data) || (data.confidence is number && data.confidence >= 0 && data.confidence <= 1))
        && (!('dedupeKeys' in data) || (data.dedupeKeys is list && data.dedupeKeys.size() <= 5))
        && (!('items' in data) || (data.items is list && data.items.size() <= 100))
        && (!('accountLast4' in data) || data.accountLast4 == null || (data.accountLast4 is string && data.accountLast4.matches('^[0-9]{4}$')))
        && (!('balanceAfterReported' in data) || data.balanceAfterReported == null || (data.balanceAfterReported is number && data.balanceAfterReported >= 0 && data.balanceAfterReported <= 1000000000000))
        && (!('bank' in data) || (data.bank is string && data.bank.size() <= 40))
        && (!('confirmationMethod' in data) || data.confirmationMethod == 'explicit_user_confirm')
        && (!('fingerprint' in data) || (data.fingerprint is string && data.fingerprint.matches('^[a-f0-9]{64}$')))
        && (!('rawTextRetained' in data) || data.rawTextRetained == false)
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && (!('reviewedByUser' in data) || data.reviewedByUser is bool)
        && (!('scanId' in data) || (data.scanId is string && data.scanId.size() <= 128))
        && (!('source' in data) || data.source in ['line_auto_listener', 'line_paste', 'line_share', 'manual_entry', 'receipt_scan'])
        && (!('status' in data) || data.status in ['verified', 'needs_review'])
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validScanLog(data, userId) {
      return data.keys().hasAll(['ownerId', 'kind', 'imagePath', 'status', 'extractedText', 'errorMessage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'kind', 'imagePath', 'status', 'extractedText', 'errorMessage', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.kind in ['schedule', 'receipt']
        && data.imagePath is string && data.imagePath.size() >= 1 && data.imagePath.size() <= 512
        && data.imagePath.matches('^users/' + userId + '/(schedules|receipts|scans)/.*')
        && data.status in ['pending', 'processing', 'completed', 'failed']
        && data.extractedText is string && data.extractedText.size() <= 30000
        && data.errorMessage is string && data.errorMessage.size() <= 1000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validFeedback(data, userId) {
      return data.keys().hasAll(['ownerId', 'type', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'type', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.type in ['ai', 'schedule-scan', 'expense-category', 'other']
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.status == 'new'
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validActivityClientCreate(data) {
      // Only createAdaptiveActivity sets clientRequestId, and it does so through
      // the Admin SDK. Keeping it out of client creates stops a forged key from
      // colliding with that callable's idempotency check.
      return !('clientRequestId' in data)
        && (!('actualDurationMinutes' in data) || data.actualDurationMinutes == null)
        && (!('actualEnd' in data) || data.actualEnd == null)
        && (!('actualStart' in data) || data.actualStart == null)
        && (!('aiConfidence' in data) || data.aiConfidence == null)
        && (!('aiReason' in data) || data.aiReason == null)
        && (!('aiScheduled' in data) || data.aiScheduled == false)
        && (!('googleSyncStatus' in data) || data.googleSyncStatus == 'not_required')
        && (!('scheduleVersion' in data) || data.scheduleVersion == 0);
    }

    function validActivityClientUpdate(data) {
      return data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'type', 'startAt', 'endAt', 'location', 'color', 'status', 'source',
        'note', 'reminder', 'category', 'priority', 'attendees', 'deadline',
        'estimatedDurationMinutes', 'isFlexible', 'isLocked', 'allowAiReschedule', 'updatedAt'
      ]);
    }

    function validAssistantConversation(data, userId) {
      return data.keys().hasAll(['ownerId', 'mode', 'title', 'lastMessagePreview', 'messageCount', 'stateJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'mode', 'title', 'lastMessagePreview', 'messageCount', 'stateJson', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.mode == 'persistent'
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000
        && data.stateJson is string && data.stateJson.size() <= 5000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validAssistantMessage(data, userId) {
      return data.keys().hasAll(['ownerId', 'role', 'content', 'payload', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'role', 'content', 'payload', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 8000
        && data.payload is string && data.payload.size() <= 20000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validGoogleCalendarIntegration(data, userId) {
      return data.keys().hasAll(['ownerId', 'provider', 'connected', 'email', 'calendarId', 'connectedAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'provider', 'connected', 'email', 'calendarId', 'connectedAt', 'lastSyncedAt', 'updatedAt'])
        && data.ownerId == userId
        && data.provider == 'google'
        && data.connected == true
        && data.email is string && data.email.size() >= 1 && data.email.size() <= 254
        && data.calendarId == 'primary'
        && data.connectedAt is timestamp
        && (!('lastSyncedAt' in data) || data.lastSyncedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function validCategory(data) {
      return data.keys().hasAll(['domain', 'labelTh', 'labelEn', 'icon', 'color', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['domain', 'labelTh', 'labelEn', 'icon', 'color', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.domain in ['note', 'expense', 'activity']
        && data.labelTh is string && data.labelTh.size() >= 1 && data.labelTh.size() <= 80
        && data.labelEn is string && data.labelEn.size() >= 1 && data.labelEn.size() <= 80
        && data.icon is string && data.icon.size() <= 60
        && validColor(data.color)
        && data.active is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'kind', 'active', 'startAt', 'endAt', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'message', 'kind', 'active', 'startAt', 'endAt', 'createdBy', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 3000
        && data.kind in ['update', 'maintenance', 'feature', 'urgent']
        && data.active is bool
        && data.startAt is timestamp && data.endAt is timestamp && data.startAt < data.endAt
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && validProfile(request.resource.data, userId)
        && (!('consentTier' in request.resource.data) || request.resource.data.consentTier == 'manual_only')
        && (!('lineConsentVersion' in request.resource.data) || request.resource.data.lineConsentVersion == 1)
        && (!('lineListenerStatus' in request.resource.data) || request.resource.data.lineListenerStatus == 'not_applicable')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'updatedAt']);
      allow delete: if false;

      match /monthlyBudgets/{monthKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userExists(userId)
          && validMonthlyBudget(request.resource.data, userId, monthKey)
          && hasValidCreateMeta(request.resource.data, userId);
        allow update: if isOwner(userId)
          && validMonthlyBudget(request.resource.data, userId, monthKey)
          && hasValidUpdateMeta(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /schedules/{scheduleId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userExists(userId) && validSchedule(request.resource.data, userId) && hasValidCreateMeta(request.resource.data, userId);
        allow update: if isOwner(userId) && validSchedule(request.resource.data, userId) && hasValidUpdateMeta(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userExists(userId) && validActivity(request.resource.data, userId) && validActivityClientCreate(request.resource.data) && hasValidCreateMeta(request.resource.data, userId);
        allow update: if isOwner(userId) && validActivity(request.resource.data, userId) && validActivityClientUpdate(request.resource.data) && hasValidUpdateMeta(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Adaptive scheduling calculations and mutations are performed only by
      // authenticated callable/scheduled functions using the Admin SDK. The
      // client can read only the data below its own UID.
      match /settings/{settingId} {
        allow read: if (isOwner(userId) || isAdmin()) && settingId == 'adaptiveScheduling';
        allow write: if false;
      }

      match /schedulingBehaviorEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /schedulingPatterns/{patternId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /schedulingSuggestions/{suggestionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /scheduleChangeHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /productivityInsights/{insightId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /pushTokens/{tokenId} {
        // Raw device tokens are implementation credentials; even the client
        // registers them through an authenticated callable and never reads them.
        allow read, write: if false;
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userExists(userId) && validNote(request.resource.data, userId) && hasValidCreateMeta(request.resource.data, userId);
        allow update: if isOwner(userId) && validNote(request.resource.data, userId) && hasValidUpdateMeta(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        // LINE-derived records are created only by trusted callable functions
        // after explicit user confirmation. A client cannot forge that audit trail.
        allow create: if isOwner(userId)
          && userExists(userId)
          && validTransaction(request.resource.data, userId)
          && hasValidCreateMeta(request.resource.data, userId)
          && (!('source' in request.resource.data) || request.resource.data.source in ['manual_entry', 'receipt_scan']);
        allow update: if isOwner(userId)
          && validTransaction(request.resource.data, userId)
          && hasValidUpdateMeta(request.resource.data, userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'amount', 'category', 'merchant', 'note', 'occurredAt',
            'status', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      match /pendingReview/{draftId} {
        // Pending raw LINE text is server-created, expires after seven days,
        // and is removed by the confirmation/rejection callable functions.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /scanLogs/{scanId} {
        // A signed-in user can only fetch OCR history stored below their UID.
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userExists(userId) && validScanLog(request.resource.data, userId) && hasValidCreateMeta(request.resource.data, userId);
        // OCR workers use the Admin SDK and bypass rules when writing extracted results.
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if false;
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['ownerId', 'title', 'message', 'kind', 'read', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['ownerId', 'title', 'message', 'kind', 'read', 'createdAt', 'updatedAt'])
          && request.resource.data.ownerId == userId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.title is string && request.resource.data.title.size() <= 160
          && request.resource.data.message is string && request.resource.data.message.size() <= 2000
          && request.resource.data.kind in ['urgent', 'ai', 'finance', 'schedule', 'system']
          && request.resource.data.read is bool
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /aiRecommendations/{recommendationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Privacy-preserving AI quality records. The app can read its own
      // diagnostics, while only trusted Cloud Functions may create or update.
      match /assistantInteractions/{interactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Persistent assistant chats are private to their owner. Temporary chats
      // never write to these paths. Message updates may only change local UI
      // metadata such as feedback or proposed-action status inside `payload`.
      match /assistantConversations/{conversationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && userExists(userId)
          && validAssistantConversation(request.resource.data, userId)
          && hasValidCreateMeta(request.resource.data, userId);
        allow update: if isOwner(userId)
          && validAssistantConversation(request.resource.data, userId)
          && hasValidUpdateMeta(request.resource.data, userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'lastMessagePreview', 'messageCount', 'stateJson', 'updatedAt']);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId)
            && userExists(userId)
            && validAssistantMessage(request.resource.data, userId)
            && hasValidCreateMeta(request.resource.data, userId);
          allow update: if isOwner(userId)
            && validAssistantMessage(request.resource.data, userId)
            && hasValidUpdateMeta(request.resource.data, userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt']);
          allow delete: if isOwner(userId);
        }
      }

      match /feedback/{feedbackId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userExists(userId) && validFeedback(request.resource.data, userId) && hasValidCreateMeta(request.resource.data, userId);
        allow update, delete: if false;
      }

      match /integrations/{integrationId} {
        allow read: if isOwner(userId);
        allow create: if integrationId == 'google-calendar'
          && isOwner(userId)
          && userExists(userId)
          && validGoogleCalendarIntegration(request.resource.data, userId)
          && request.resource.data.connectedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if integrationId == 'google-calendar'
          && isOwner(userId)
          && validGoogleCalendarIntegration(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.connectedAt == resource.data.connectedAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if integrationId == 'google-calendar' && isOwner(userId);
      }
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        && validCategory(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validCategory(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin()
        || (isAuthenticated()
          && resource.data.active == true
          && resource.data.startAt <= request.time
          && resource.data.endAt > request.time);
      allow create: if isAdmin()
        && validAnnouncement(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validAnnouncement(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /systemStatus/{serviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
