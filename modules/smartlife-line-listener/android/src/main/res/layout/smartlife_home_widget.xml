<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/smartlife_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/smartlife_widget_background"
  android:orientation="vertical"
  android:padding="18dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="84dp"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <TextView
        android:id="@+id/smartlife_widget_date_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="วันนี้"
        android:textColor="#BB9293"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/smartlife_widget_day_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="--"
        android:textColor="#1E2818"
        android:textSize="42sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <TextView
        android:id="@+id/smartlife_widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="SmartLife"
        android:textColor="#7B746D"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/smartlife_widget_subheadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/smartlife_widget_pill"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="เปิดแอปเพื่ออัปเดตข้อมูลวันนี้"
        android:textColor="#7B651F"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/smartlife_widget_focus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="ยังไม่มีงานที่ต้องโฟกัส"
    android:textColor="#8B9085"
    android:textSize="15sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/smartlife_widget_soft_panel"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
      android:id="@+id/smartlife_widget_budget"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="งบวันนี้ —"
      android:textColor="#5F835F"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/smartlife_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="ยังไม่อัปเดต"
      android:textColor="#8B9085"
      android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
