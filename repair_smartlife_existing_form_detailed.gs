function addRatingGrid_(form, title, rows) {
  form.addGridItem()
    .setTitle(title)
    .setHelpText('เลือกคะแนน 1–5 ในแต่ละแถว โดย 1 = น้อยที่สุด และ 5 = มากที่สุด')
    .setRows(rows)
    .setColumns([
      '1 = น้อยที่สุด',
      '2 = น้อย',
      '3 = ปานกลาง',
      '4 = มาก',
      '5 = มากที่สุด',
    ])
    .setRequired(true);
}

function addChoice_(form, title, choices, required) {
  form.addMultipleChoiceItem()
    .setTitle(title)
    .setChoiceValues(choices)
    .setRequired(required);
}

function addCheckbox_(form, title, choices, required) {
  form.addCheckboxItem()
    .setTitle(title)
    .setChoiceValues(choices)
    .setRequired(required);
}

function addOptionalText_(form, title) {
  form.addParagraphTextItem()
    .setTitle(title)
    .setHelpText('ตอบหรือไม่ตอบก็ได้')
    .setRequired(false);
}
