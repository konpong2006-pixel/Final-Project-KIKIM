function grid(f,t,r){f.addGridItem().setTitle(t).setHelpText('เลือกคะแนน 1–5 ในแต่ละแถว โดย 1 = น้อยที่สุด และ 5 = มากที่สุด').setRows(r).setColumns(['1 = น้อยที่สุด','2 = น้อย','3 = ปานกลาง','4 = มาก','5 = มากที่สุด']).setRequired(true);}
function choice(f,t,c,r){f.addMultipleChoiceItem().setTitle(t).setChoiceValues(c).setRequired(r);}
function check(f,t,c,r){f.addCheckboxItem().setTitle(t).setChoiceValues(c).setRequired(r);}
function text(f,t){f.addParagraphTextItem().setTitle(t).setHelpText('ตอบหรือไม่ตอบก็ได้').setRequired(false);}
