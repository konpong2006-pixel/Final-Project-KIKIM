rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isImageUnder(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function isAllowedOcrImage(fileName, maxBytes) {
      return isImageUnder(maxBytes)
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && fileName.matches('.*[.](jpg|jpeg|png|webp)');
    }

    function isAllowedReceipt(fileName, maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && (
          (
            request.resource.contentType.matches('image/(jpeg|png)')
            && fileName.matches('.*[.](jpg|jpeg|png)')
          )
          || (
            request.resource.contentType == 'application/pdf'
            && fileName.matches('.*[.]pdf')
          )
        );
    }

    function isAllowedAssistantFile(fileName, maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && (
          (request.resource.contentType == 'application/pdf' && fileName.matches('.*[.]pdf'))
          || (request.resource.contentType == 'text/plain' && fileName.matches('.*[.]txt'))
          || (request.resource.contentType == 'text/csv' && fileName.matches('.*[.]csv'))
          || (request.resource.contentType == 'text/calendar' && fileName.matches('.*[.]ics'))
        );
    }

    match /users/{userId}/avatars/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isImageUnder(5 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/receipts/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isAllowedReceipt(fileName, 10 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/schedules/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isImageUnder(10 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/scans/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isAllowedOcrImage(fileName, 10 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    // Drawings and handwriting attached to a note. Images only, and small:
    // a note's canvas is a PNG snapshot, not a photo library.
    match /users/{userId}/notes/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isAllowedOcrImage(fileName, 5 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/assistant-files/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isAllowedAssistantFile(fileName, 8 * 1024 * 1024);
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
